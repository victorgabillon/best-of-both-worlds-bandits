module

public import BestOfBothWorlds.AdaptiveBanditProcess
public import BestOfBothWorlds.ConditionalActionSampling

/-!
Conditional moments of the finite adaptive process. Conditional expectation is
first transported from a one-round law to a trajectory marginal, then restricted
to the filtration generated by selected arms and observed rewards.
-/

@[expose] public section

open MeasureTheory

namespace BestOfBothWorlds.AdaptiveBanditMoments

section Transport

variable {Ω Ξ : Type*} [mΩ : MeasurableSpace Ω] [mΞ : MeasurableSpace Ξ]

theorem setIntegral_comp_measurePreserving (P : Measure Ω) (Q : Measure Ξ)
    (q : Ω → Ξ) (hq : MeasurePreserving q P Q) (F : Ξ → ℝ)
    (hF : AEStronglyMeasurable F Q) (B : Set Ξ) (hB : MeasurableSet B) :
    (∫ ω in q ⁻¹' B, F (q ω) ∂P) = ∫ ξ in B, F ξ ∂Q := by
  have hFmap : AEStronglyMeasurable F (P.map q) := by
    rw [hq.map_eq]
    exact hF
  have h := setIntegral_map hB hFmap hq.measurable.aemeasurable
  rw [hq.map_eq] at h
  exact h.symm

/-- Transport genuine conditional expectation along a proved trajectory marginal. -/
theorem condExp_comp_measurePreserving (P : Measure Ω) [IsFiniteMeasure P]
    (Q : Measure Ξ) [IsFiniteMeasure Q] (q : Ω → Ξ) (hq : MeasurePreserving q P Q)
    (m : MeasurableSpace Ξ) (hm : m ≤ mΞ) (F G : Ξ → ℝ)
    (hF : Integrable F Q) (hGm : StronglyMeasurable[m] G)
    (hCE : Q[F | m] =ᵐ[Q] G) :
    P[(F ∘ q) | m.comap q] =ᵐ[P] (G ∘ q) := by
  let : MeasurableSpace Ξ := mΞ
  have hG : Integrable G Q := integrable_condExp.congr hCE
  have hFsource : Integrable (F ∘ q) P :=
    (hq.integrable_comp hF.aestronglyMeasurable).2 hF
  have hGsource : Integrable (G ∘ q) P :=
    (hq.integrable_comp hG.aestronglyMeasurable).2 hG
  have hmSource : m.comap q ≤ mΩ :=
    (MeasurableSpace.comap_mono hm).trans hq.measurable.comap_le
  have hqm : @Measurable Ω Ξ (m.comap q) m q := comap_measurable q
  have hGsource_m : StronglyMeasurable[m.comap q] (G ∘ q) :=
    hGm.comp_measurable hqm
  refine (ae_eq_condExp_of_forall_setIntegral_eq hmSource hFsource
    (fun _ _ _ => hGsource.integrableOn) ?_ hGsource_m.aestronglyMeasurable).symm
  intro s hs _
  rcases (MeasurableSpace.measurableSet_comap (f := q)).mp hs with ⟨B, hB, rfl⟩
  calc
    (∫ ω in q ⁻¹' B, (G ∘ q) ω ∂P) = ∫ ξ in B, G ξ ∂Q :=
      setIntegral_comp_measurePreserving P Q q hq G hG.aestronglyMeasurable B (hm B hB)
    _ = ∫ ξ in B, Q[F | m] ξ ∂Q := integral_congr_ae (ae_restrict_of_ae hCE.symm)
    _ = ∫ ξ in B, F ξ ∂Q := setIntegral_condExp hm hF hB
    _ = ∫ ω in q ⁻¹' B, (F ∘ q) ω ∂P :=
      (setIntegral_comp_measurePreserving P Q q hq F hF.aestronglyMeasurable B (hm B hB)).symm

/-- Passing from a latent past to observed history preserves observable conditional moments. -/
theorem condExp_shrink (P : Measure Ω) [IsFiniteMeasure P]
    (mSmall mBig : MeasurableSpace Ω) (hSmallBig : mSmall ≤ mBig) (hBig : mBig ≤ mΩ)
    (F G : Ω → ℝ) (hGm : StronglyMeasurable[mSmall] G)
    (hCE : P[F | mBig] =ᵐ[P] G) : P[F | mSmall] =ᵐ[P] G := by
  have hG : Integrable G P := integrable_condExp.congr hCE
  have htower := condExp_condExp_of_le (f := F) (μ := P) hSmallBig hBig
  have hcongr := condExp_congr_ae (m := mSmall) hCE
  rw [condExp_of_stronglyMeasurable (hSmallBig.trans hBig) hGm hG] at hcongr
  exact htower.symm.trans hcongr

end Transport

open AdaptiveBanditProcess

variable {K : ℕ}

/-- Importance weighting uses the selected reward, and is stopped at the horizon. -/
noncomputable def importanceWeighted (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ)
    (z : Trajectory K n) : ℝ :=
  if ht : t < n then
    ConditionalImportanceWeighting.estimator (rawPolicy π t) k (roundOutcome t n ht z)
  else 0

/-- The centered, stopped estimation error at round `t`. -/
noncomputable def increment (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    (n : ℕ) (k : Fin K) (t : ℕ) (z : Trajectory K n) : ℝ :=
  importanceWeighted π n k t z - if t < n then StochasticImportanceWeighting.mean (ν t) k else 0

noncomputable def samplingProbability (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ)
    (z : Trajectory K n) : ℝ :=
  if ht : t < n then π.prob t (historyAt n t (Nat.le_of_lt ht) z) k else 0

noncomputable def reciprocalProbability (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ)
    (z : Trajectory K n) : ℝ :=
  if ht : t < n then 1 / π.prob t (historyAt n t (Nat.le_of_lt ht) z) k else 0

/-- The exact conditional second moment, known before the next action. -/
noncomputable def varianceIncrement (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    (n : ℕ) (k : Fin K) (t : ℕ) (z : Trajectory K n) : ℝ :=
  if ht : t < n then
    StochasticImportanceWeighting.secondMoment (ν t) k /
        π.prob t (historyAt n t (Nat.le_of_lt ht) z) k -
      (StochasticImportanceWeighting.mean (ν t) k) ^ 2
  else 0

noncomputable def pullIndicator (n : ℕ) (k : Fin K) (t : ℕ) (z : Trajectory K n) : ℝ :=
  if ht : t < n then if roundAction t n ht z = k then 1 else 0 else 0

theorem increment_eq_weighted_sub_mean (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    (n : ℕ) (k : Fin K) (t : ℕ) (z : Trajectory K n) :
    increment π ν n k t z = importanceWeighted π n k t z -
      (if t < n then StochasticImportanceWeighting.mean (ν t) k else 0) := rfl

theorem samplingProbability_bounds (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ)
    (z : Trajectory K n) :
    0 ≤ samplingProbability π n k t z ∧ samplingProbability π n k t z ≤ 1 := by
  by_cases ht : t < n
  · simp only [samplingProbability, dite_eq_left ht]
    exact ⟨(π.positive _ _ _).le,
      ImportanceWeighting.probability_le_one (π.prob t) (π.positive t) (π.normalized t) _ k⟩
  · simp [samplingProbability, ht]

theorem reciprocalProbability_uniform_bound (π : Policy K) (n : ℕ) (ε : ℝ) (hε : 0 < ε)
    (hfloor : ∀ t < n, ∀ h k, ε ≤ π.prob t h k) (k : Fin K) (t : ℕ)
    (z : Trajectory K n) : reciprocalProbability π n k t z ≤ 1 / ε := by
  by_cases ht : t < n
  · simp only [reciprocalProbability, dite_eq_left ht]
    exact one_div_le_one_div_of_le hε (hfloor t ht _ k)
  · simpa [reciprocalProbability, ht] using (one_div_pos.mpr hε).le

theorem varianceIncrement_bounds (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    [∀ t, IsProbabilityMeasure (ν t)] (n : ℕ)
    (hbound : ∀ t < n, ∀ᵐ y ∂ν t, ∀ k, 0 ≤ y k ∧ y k ≤ 1)
    (k : Fin K) (t : ℕ) (z : Trajectory K n) :
    0 ≤ varianceIncrement π ν n k t z ∧
      varianceIncrement π ν n k t z ≤ reciprocalProbability π n k t z := by
  by_cases ht : t < n
  · simp only [varianceIncrement, reciprocalProbability, dite_eq_left ht]
    have heq := StochasticImportanceWeighting.centered_second_moment (rawPolicy π t)
      (rawPolicy_pos π t) (rawPolicy_norm π t) (ν t) (hbound t ht)
      (trajectoryPrefix t n (Nat.le_of_lt ht) z) k
    have hlo := StochasticImportanceWeighting.variance_nonneg (rawPolicy π t)
      (rawPolicy_pos π t) (rawPolicy_norm π t) (ν t)
      (trajectoryPrefix t n (Nat.le_of_lt ht) z) k
    have hhi := StochasticImportanceWeighting.variance_bound (rawPolicy π t)
      (rawPolicy_pos π t) (rawPolicy_norm π t) (ν t) (hbound t ht)
      (trajectoryPrefix t n (Nat.le_of_lt ht) z) k
    rw [heq] at hlo hhi
    exact ⟨hlo, hhi⟩
  · simp [varianceIncrement, reciprocalProbability, ht]

theorem samplingProbability_stronglyMeasurable (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ) :
    StronglyMeasurable[historyFiltration n t] (samplingProbability π n k t) := by
  unfold samplingProbability
  by_cases ht : t < n
  · simp only [dite_eq_left ht]
    exact (policy_observable π (Nat.le_of_lt ht) k).stronglyMeasurable
  · simp only [dite_eq_right ht]
    exact stronglyMeasurable_const

theorem varianceIncrement_stronglyMeasurable (π : Policy K)
    (ν : ℕ → Measure (Fin K → ℝ)) (n : ℕ) (k : Fin K) (t : ℕ) :
    StronglyMeasurable[historyFiltration n t] (varianceIncrement π ν n k t) := by
  unfold varianceIncrement
  by_cases ht : t < n
  · simp only [dite_eq_left ht]
    exact ((measurable_const.div (policy_observable π (Nat.le_of_lt ht) k)).sub
      measurable_const).stronglyMeasurable
  · simp only [dite_eq_right ht]
    exact stronglyMeasurable_const

theorem pullIndicator_stronglyMeasurable (n : ℕ) (k : Fin K) (t : ℕ) :
    StronglyMeasurable[historyFiltration n (t+1)] (pullIndicator n k t) := by
  unfold pullIndicator
  by_cases ht : t < n
  · simp only [dite_eq_left ht]
    exact (Measurable.ite (measurableSet_eq_fun (roundAction_observable ht) measurable_const)
      measurable_const measurable_const).stronglyMeasurable
  · simp only [dite_eq_right ht]
    exact stronglyMeasurable_const

theorem round_policy_eq (π : Policy K) {n t : ℕ} (ht : t < n) (k : Fin K)
    (z : Trajectory K n) :
    rawPolicy π t (ConditionalImportanceWeighting.history (roundOutcome t n ht z)) k =
      π.prob t (historyAt n t (Nat.le_of_lt ht) z) k := by
  change π.prob t (observe ((roundOutcome t n ht z).1.1)) k = _
  rw [congrFun (roundOutcome_history ht) z]
  rfl

theorem importanceWeighted_formula (π : Policy K) {n t : ℕ} (ht : t < n) (k : Fin K)
    (z : Trajectory K n) : importanceWeighted π n k t z =
      if roundAction t n ht z = k then roundObservedReward t n ht z /
        π.prob t (historyAt n t (Nat.le_of_lt ht) z) k else 0 := by
  simp only [importanceWeighted, dite_eq_left ht]
  unfold ConditionalImportanceWeighting.estimator StochasticImportanceWeighting.estimator
    ImportanceWeighting.estimator
  rw [round_policy_eq π ht k z]
  rfl

theorem importanceWeighted_stronglyMeasurable (π : Policy K) (n : ℕ) (k : Fin K) (t : ℕ) :
    StronglyMeasurable[historyFiltration n (t+1)] (importanceWeighted π n k t) := by
  by_cases ht : t < n
  · have heq : importanceWeighted π n k t = fun z =>
        if roundAction t n ht z = k then roundObservedReward t n ht z /
          π.prob t (historyAt n t (Nat.le_of_lt ht) z) k else 0 :=
      funext (importanceWeighted_formula π ht k)
    rw [heq]
    exact (Measurable.ite (measurableSet_eq_fun (roundAction_observable ht) measurable_const)
      ((roundObservedReward_observable ht).div
        ((policy_observable π (Nat.le_of_lt ht) k).mono
          ((historyFiltration n).mono (Nat.le_succ t)) le_rfl)) measurable_const).stronglyMeasurable
  · unfold importanceWeighted
    simp only [dite_eq_right ht]
    exact stronglyMeasurable_const

theorem increment_stronglyMeasurable (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    (n : ℕ) (k : Fin K) (t : ℕ) :
    StronglyMeasurable[historyFiltration n (t+1)] (increment π ν n k t) :=
  (importanceWeighted_stronglyMeasurable π n k t).sub stronglyMeasurable_const

theorem importanceWeighted_eq_comp (π : Policy K) {n t : ℕ} (ht : t < n) (k : Fin K) :
    importanceWeighted π n k t =
      ConditionalImportanceWeighting.estimator (rawPolicy π t) k ∘ roundOutcome t n ht := by
  funext z
  simp [importanceWeighted, ht]

theorem increment_eq_comp (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
    {n t : ℕ} (ht : t < n) (k : Fin K) :
    increment π ν n k t =
      ConditionalImportanceWeighting.centered (rawPolicy π t) (ν t) k ∘ roundOutcome t n ht := by
  funext z
  simp only [increment, importanceWeighted, dite_eq_left ht, ite_eq_left ht, Function.comp_apply]
  rfl

section ProcessLaw

variable (π : Policy K) (ν : ℕ → Measure (Fin K → ℝ))
variable [∀ t, IsProbabilityMeasure (ν t)]

/-- An actual one-round conditional law remains valid in the complete trajectory,
and the tower law removes unobserved coordinates of the raw past. -/
theorem conditional_round_observed {n t : ℕ} (ht : t < n)
    (F : Trajectory K (t+1) → ℝ) (G : ObservedHistory K t → ℝ)
    (hF : Integrable F (trajectoryLaw π ν (t+1))) (hG : Measurable G)
    (hCE : (trajectoryLaw π ν (t+1))[F | ConditionalImportanceWeighting.historySigma]
      =ᵐ[trajectoryLaw π ν (t+1)]
        (fun w => G (observe (ConditionalImportanceWeighting.history w)))) :
    (trajectoryLaw π ν n)[(F ∘ roundOutcome t n ht) | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n] (fun z => G (historyAt n t (Nat.le_of_lt ht) z)) := by
  have hGtarget : StronglyMeasurable[ConditionalImportanceWeighting.historySigma]
      (fun w : Trajectory K (t+1) => G (observe (ConditionalImportanceWeighting.history w))) :=
    (ConditionalImportanceWeighting.history_function_measurable
      (fun x : Trajectory K t => G (observe x)) (hG.comp (observe_measurable K t))).stronglyMeasurable
  have hraw := condExp_comp_measurePreserving (trajectoryLaw π ν n) (trajectoryLaw π ν (t+1))
    (roundOutcome t n ht) (roundOutcome_measurePreserving π ν ht)
    ConditionalImportanceWeighting.historySigma ConditionalImportanceWeighting.historySigma_le
    F _ hF hGtarget hCE
  have heq : ((fun w : Trajectory K (t+1) =>
      G (observe (ConditionalImportanceWeighting.history w))) ∘ roundOutcome t n ht) =
        (fun z => G (historyAt n t (Nat.le_of_lt ht) z)) := by
    funext z
    change G (observe ((roundOutcome t n ht z).1.1)) = _
    rw [congrFun (roundOutcome_history ht) z]
    rfl
  rw [heq] at hraw
  exact condExp_shrink (trajectoryLaw π ν n) (historyFiltration n t)
    ((ConditionalImportanceWeighting.historySigma).comap (roundOutcome t n ht))
    (observed_le_raw_round ht)
    ((MeasurableSpace.comap_mono ConditionalImportanceWeighting.historySigma_le).trans
      (roundOutcome_measurable ht).comap_le) _ _
    (hG.comp (historyAt_observable (Nat.le_of_lt ht))).stronglyMeasurable hraw

section BoundedRewards

variable (n : ℕ) (hbound : ∀ t < n, ∀ᵐ y ∂ν t, ∀ k, 0 ≤ y k ∧ y k ≤ 1)
variable (ε : ℝ) (hε : 0 < ε) (hfloor : ∀ t < n, ∀ h k, ε ≤ π.prob t h k)

include hbound hε hfloor in
theorem conditional_unbiased (k : Fin K) (t : ℕ) :
    (trajectoryLaw π ν n)[importanceWeighted π n k t | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n]
        (fun _ => if t < n then StochasticImportanceWeighting.mean (ν t) k else 0) := by
  by_cases ht : t < n
  · have hf : ∀ x k, ε ≤ rawPolicy π t x k := fun x k => hfloor t ht (observe x) k
    have h := conditional_round_observed π ν ht
      (ConditionalImportanceWeighting.estimator (rawPolicy π t) k)
      (fun _ => StochasticImportanceWeighting.mean (ν t) k)
      (ConditionalImportanceWeighting.estimator_integrable (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) ε hε hf k) measurable_const
      (ConditionalImportanceWeighting.conditional_unbiased (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) ε hε hf k)
    rw [importanceWeighted_eq_comp π ht k]
    simp only [ite_eq_left ht]
    exact h
  · unfold importanceWeighted
    simp only [dite_eq_right ht, ite_eq_right ht]
    rw [condExp_const (μ := trajectoryLaw π ν n) ((historyFiltration n).le t) (0 : ℝ)]

include hbound hε hfloor in
theorem conditional_increment_zero (k : Fin K) (t : ℕ) :
    (trajectoryLaw π ν n)[increment π ν n k t | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n] (fun _ => 0) := by
  by_cases ht : t < n
  · have hf : ∀ x k, ε ≤ rawPolicy π t x k := fun x k => hfloor t ht (observe x) k
    rw [increment_eq_comp π ν ht k]
    exact conditional_round_observed π ν ht
      (ConditionalImportanceWeighting.centered (rawPolicy π t) (ν t) k) (fun _ => 0)
      (ConditionalImportanceWeighting.centered_integrable (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) ε hε hf k) measurable_const
      (ConditionalImportanceWeighting.conditional_centered_mean_zero (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) ε hε hf k)
  · unfold increment importanceWeighted
    simp only [dite_eq_right ht, ite_eq_right ht, sub_zero]
    rw [condExp_const (μ := trajectoryLaw π ν n) ((historyFiltration n).le t) (0 : ℝ)]

include hbound hε hfloor in
theorem conditional_second_moment (k : Fin K) (t : ℕ) (ht : t < n) :
    (trajectoryLaw π ν n)[(fun z => (importanceWeighted π n k t z)^2) | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n]
        (fun z => StochasticImportanceWeighting.secondMoment (ν t) k /
          π.prob t (historyAt n t (Nat.le_of_lt ht) z) k) := by
  have hf : ∀ x k, ε ≤ rawPolicy π t x k := fun x k => hfloor t ht (observe x) k
  have heq : (fun z => (importanceWeighted π n k t z)^2) =
      (fun w => (ConditionalImportanceWeighting.estimator (rawPolicy π t) k w)^2) ∘
        roundOutcome t n ht := by
    funext z
    rw [congrFun (importanceWeighted_eq_comp π ht k) z]
    rfl
  rw [heq]
  exact conditional_round_observed π ν ht
    (fun w => (ConditionalImportanceWeighting.estimator (rawPolicy π t) k w)^2)
    (fun h => StochasticImportanceWeighting.secondMoment (ν t) k / π.prob t h k)
    (ConditionalImportanceWeighting.estimator_square_integrable (rawPolicy π t) (rawPolicy_pos π t)
      (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
      (hbound t ht) ε hε hf k) (measurable_const.div (π.measurable_prob t k))
    (ConditionalImportanceWeighting.conditional_second_moment (rawPolicy π t) (rawPolicy_pos π t)
      (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
      (hbound t ht) ε hε hf k)

include hbound hε hfloor in
theorem conditional_increment_square (k : Fin K) (t : ℕ) :
    (trajectoryLaw π ν n)[(fun z => (increment π ν n k t z)^2) | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n] varianceIncrement π ν n k t := by
  by_cases ht : t < n
  · have hf : ∀ x k, ε ≤ rawPolicy π t x k := fun x k => hfloor t ht (observe x) k
    have heq : (fun z => (increment π ν n k t z)^2) =
        (fun w => (ConditionalImportanceWeighting.centered (rawPolicy π t) (ν t) k w)^2) ∘
          roundOutcome t n ht := by
      funext z
      rw [congrFun (increment_eq_comp π ν ht k) z]
      rfl
    rw [heq]
    unfold varianceIncrement
    simp only [dite_eq_left ht]
    exact conditional_round_observed π ν ht
      (fun w => (ConditionalImportanceWeighting.centered (rawPolicy π t) (ν t) k w)^2)
      (fun h => StochasticImportanceWeighting.secondMoment (ν t) k / π.prob t h k -
        (StochasticImportanceWeighting.mean (ν t) k)^2)
      (ConditionalImportanceWeighting.centered_square_integrable (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) ε hε hf k)
      ((measurable_const.div (π.measurable_prob t k)).sub measurable_const)
      (ConditionalImportanceWeighting.conditional_centered_second_moment (rawPolicy π t)
        (rawPolicy_pos π t) (rawPolicy_norm π t) (rawPolicy_measurable π t)
        (trajectoryLaw π ν t) (ν t) (hbound t ht) ε hε hf k)
  · unfold increment importanceWeighted varianceIncrement
    simp only [dite_eq_right ht, ite_eq_right ht, sub_zero, zero_pow (by decide : 2 ≠ 0)]
    rw [condExp_const (μ := trajectoryLaw π ν n) ((historyFiltration n).le t) (0 : ℝ)]

include hbound in
theorem importanceWeighted_bounds (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n, 0 ≤ importanceWeighted π n k t z ∧
      importanceWeighted π n k t z ≤ reciprocalProbability π n k t z := by
  by_cases ht : t < n
  · have h := (roundOutcome_measurePreserving π ν ht).quasiMeasurePreserving.ae
      (ConditionalImportanceWeighting.estimator_bounds (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) k)
    filter_upwards [h] with z hz
    rw [congrFun (importanceWeighted_eq_comp π ht k) z, Function.comp_apply]
    unfold reciprocalProbability
    simp only [dite_eq_left ht]
    rw [← round_policy_eq π ht k z]
    exact hz
  · exact Filter.Eventually.of_forall (fun z => by
      simp [importanceWeighted, reciprocalProbability, ht])

include hbound in
theorem increment_bound (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n,
      |increment π ν n k t z| ≤ reciprocalProbability π n k t z := by
  by_cases ht : t < n
  · have h := (roundOutcome_measurePreserving π ν ht).quasiMeasurePreserving.ae
      (ConditionalImportanceWeighting.increment_bound (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t)
        (hbound t ht) k)
    filter_upwards [h] with z hz
    rw [congrFun (increment_eq_comp π ν ht k) z, Function.comp_apply]
    unfold reciprocalProbability
    simp only [dite_eq_left ht]
    rw [← round_policy_eq π ht k z]
    exact hz
  · exact Filter.Eventually.of_forall (fun z => by
      simp [increment, importanceWeighted, reciprocalProbability, ht])

include hbound hε hfloor in
theorem importanceWeighted_uniform_bound (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n, |importanceWeighted π n k t z| ≤ 1 / ε := by
  filter_upwards [importanceWeighted_bounds π ν n hbound k t] with z hz
  rw [abs_of_nonneg hz.1]
  exact hz.2.trans (reciprocalProbability_uniform_bound π n ε hε hfloor k t z)

include hbound hε hfloor in
theorem increment_uniform_bound (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n, |increment π ν n k t z| ≤ 1 / ε := by
  filter_upwards [increment_bound π ν n hbound k t] with z hz
  exact hz.trans (reciprocalProbability_uniform_bound π n ε hε hfloor k t z)

include hbound hε hfloor in
theorem importanceWeighted_integrable (k : Fin K) (t : ℕ) :
    Integrable (importanceWeighted π n k t) (trajectoryLaw π ν n) := by
  apply Integrable.of_bound
    ((importanceWeighted_stronglyMeasurable π n k t).mono
      ((historyFiltration n).le (t+1))).aestronglyMeasurable (1 / ε)
  simpa only [Real.norm_eq_abs] using importanceWeighted_uniform_bound π ν n hbound ε hε hfloor k t

include hbound hε hfloor in
theorem importanceWeighted_square_integrable (k : Fin K) (t : ℕ) :
    Integrable (fun z => (importanceWeighted π n k t z)^2) (trajectoryLaw π ν n) := by
  apply Integrable.of_bound
    (((importanceWeighted_stronglyMeasurable π n k t).measurable.mono
      ((historyFiltration n).le (t+1)) le_rfl).pow_const 2).aestronglyMeasurable ((1 / ε)^2)
  filter_upwards [importanceWeighted_uniform_bound π ν n hbound ε hε hfloor k t] with z hz
  simpa only [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg (importanceWeighted π n k t z)), sq_abs] using
    pow_le_pow_left₀ (abs_nonneg (importanceWeighted π n k t z)) hz 2

include hbound hε hfloor in
theorem increment_integrable (k : Fin K) (t : ℕ) :
    Integrable (increment π ν n k t) (trajectoryLaw π ν n) :=
  (importanceWeighted_integrable π ν n hbound ε hε hfloor k t).sub (integrable_const _)

include hbound hε hfloor in
theorem increment_square_integrable (k : Fin K) (t : ℕ) :
    Integrable (fun z => (increment π ν n k t z)^2) (trajectoryLaw π ν n) := by
  apply Integrable.of_bound
    (((increment_stronglyMeasurable π ν n k t).measurable.mono
      ((historyFiltration n).le (t+1)) le_rfl).pow_const 2).aestronglyMeasurable ((1 / ε)^2)
  filter_upwards [increment_uniform_bound π ν n hbound ε hε hfloor k t] with z hz
  simpa only [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg (increment π ν n k t z)), sq_abs] using
    pow_le_pow_left₀ (abs_nonneg (increment π ν n k t z)) hz 2

include hbound hε hfloor in
theorem conditional_variance_bounds (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n,
      0 ≤ (trajectoryLaw π ν n)[(fun w => (increment π ν n k t w)^2) | historyFiltration n t] z ∧
      (trajectoryLaw π ν n)[(fun w => (increment π ν n k t w)^2) | historyFiltration n t] z ≤
        reciprocalProbability π n k t z := by
  filter_upwards [conditional_increment_square π ν n hbound ε hε hfloor k t] with z hz
  rw [hz]
  exact varianceIncrement_bounds π ν n hbound k t z

include hbound hε hfloor in
theorem conditional_variance_uniform_bound (k : Fin K) (t : ℕ) :
    ∀ᵐ z ∂trajectoryLaw π ν n,
      (trajectoryLaw π ν n)[(fun w => (increment π ν n k t w)^2) | historyFiltration n t] z ≤
        1 / ε := by
  filter_upwards [conditional_variance_bounds π ν n hbound ε hε hfloor k t] with z hz
  exact hz.2.trans (reciprocalProbability_uniform_bound π n ε hε hfloor k t z)

end BoundedRewards

theorem pullIndicator_integrable (n : ℕ) (k : Fin K) (t : ℕ) :
    Integrable (pullIndicator n k t) (trajectoryLaw π ν n) := by
  apply Integrable.of_bound
    ((pullIndicator_stronglyMeasurable n k t).mono
      ((historyFiltration n).le (t+1))).aestronglyMeasurable 1
  exact Filter.Eventually.of_forall (fun z => by
    by_cases ht : t < n
    · by_cases ha : roundAction t n ht z = k <;> simp [pullIndicator, ht, ha]
    · simp [pullIndicator, ht])

theorem samplingProbability_integrable (n : ℕ) (k : Fin K) (t : ℕ) :
    Integrable (samplingProbability π n k t) (trajectoryLaw π ν n) := by
  apply Integrable.of_bound
    ((samplingProbability_stronglyMeasurable π n k t).mono
      ((historyFiltration n).le t)).aestronglyMeasurable 1
  exact Filter.Eventually.of_forall (fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (samplingProbability_bounds π n k t z).1]
    exact (samplingProbability_bounds π n k t z).2)

theorem conditional_pullIndicator (n : ℕ) (k : Fin K) (t : ℕ) :
    (trajectoryLaw π ν n)[pullIndicator n k t | historyFiltration n t]
      =ᵐ[trajectoryLaw π ν n] samplingProbability π n k t := by
  by_cases ht : t < n
  · have heq : pullIndicator n k t =
        (fun w => if ConditionalImportanceWeighting.action w = k then (1 : ℝ) else 0) ∘
          roundOutcome t n ht := by
      funext z
      simp only [pullIndicator, dite_eq_left ht, Function.comp_apply]
      rfl
    rw [heq]
    unfold samplingProbability
    simp only [dite_eq_left ht]
    exact conditional_round_observed π ν ht
      (fun w => if ConditionalImportanceWeighting.action w = k then (1 : ℝ) else 0)
      (fun h => π.prob t h k)
      (ConditionalActionSampling.indicator_integrable (trajectoryLaw π ν (t+1))
        ConditionalImportanceWeighting.action ConditionalImportanceWeighting.action_measurable k)
      (π.measurable_prob t k)
      (ConditionalActionSampling.conditional_indicator (rawPolicy π t) (rawPolicy_pos π t)
        (rawPolicy_norm π t) (rawPolicy_measurable π t) (trajectoryLaw π ν t) (ν t) k)
  · unfold pullIndicator samplingProbability
    simp only [dite_eq_right ht]
    rw [condExp_const (μ := trajectoryLaw π ν n) ((historyFiltration n).le t) (0 : ℝ)]

end ProcessLaw

